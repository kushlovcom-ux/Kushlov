# ============================================================================
# Kushlov — Environment Variables (copy to .env and fill in real values)
# NEVER commit your real .env file. Secrets must only live in environment vars.
# ============================================================================

# --- Core ---
NODE_ENV=development
PORT=5000

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/kushlov

# --- Redis (optional, used for rate-limit store / socket adapter / caching) ---
REDIS_URL=redis://127.0.0.1:6379

# --- JWT / Auth ---
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# NextAuth-style secrets (used by the web app for cookie encryption)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me_nextauth_secret

# --- Frontend <-> Backend ---
# Local dev:
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Production (Vercel — use your real URLs):
# NEXT_PUBLIC_API_URL=https://kushlov-server.vercel.app
# NEXT_PUBLIC_SOCKET_URL=https://kushlov-server.vercel.app
# NEXT_PUBLIC_SITE_URL=https://kushlov-web.vercel.app
# CLIENT_URL=https://kushlov-web.vercel.app
# CORS_ORIGINS=https://kushlov-web.vercel.app

# --- Cloudinary ---
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- LiveKit (audio/video calls + live streaming) ---
LIVEKIT_URL=wss://your-livekit-host.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-host.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Mail (forgot/reset password). Uses console transport if unset ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kushlov <no-reply@kushlov.app>"

# --- Payments (abstraction layer; mock provider works out of the box) ---
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Location / local exclusion zone (OpenStreetMap coordinates, km) ---
# Users WITHIN this radius cannot see or connect; only users farther away can.
DISCOVERY_RADIUS_KM=20

# --- Bootstrap admin (seeded on first run if set) ---
ADMIN_EMAIL=admin@kushlov.app
ADMIN_PASSWORD=Admin@12345

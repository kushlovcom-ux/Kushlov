# ============================================================================
# Kushlov — Environment Variables (copy to .env and fill in real values)
# NEVER commit your real .env file. Secrets must only live in environment vars.
# ============================================================================

# --- Core ---
NODE_ENV=development
PORT=5000

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/kushlov

# --- Redis (optional, used for rate-limit store / socket adapter / caching) ---
REDIS_URL=redis://127.0.0.1:6379

# --- JWT / Auth ---
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# NextAuth-style secrets (used by the web app for cookie encryption)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me_nextauth_secret

# --- Frontend <-> Backend ---
# Local dev:
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Production (Vercel — set these on BOTH kushlov-web and kushlov-server projects):
# NEXT_PUBLIC_API_URL=https://kushlov-server.vercel.app
# NEXT_PUBLIC_SOCKET_URL=https://kushlov-server.vercel.app
# NEXT_PUBLIC_SITE_URL=https://kushlov-web.vercel.app
# CLIENT_URL=https://kushlov-web.vercel.app
# CORS_ORIGINS=https://kushlov-web.vercel.app

# --- Cloudinary ---
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- LiveKit (audio/video calls + live streaming) ---
LIVEKIT_URL=wss://kushlov-o68klnl3.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://kushlov-o68klnl3.livekit.cloud
LIVEKIT_API_KEY=APInkG5Up8eNfkx
LIVEKIT_API_SECRET=XfX8xKreEH8uxjpNQdSeLdP4bBAHjhpcX2k3rZnfwxjC

# --- Mail (forgot/reset password). Uses console transport if unset ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kushlov <no-reply@kushlov.app>"

# --- Payments ---
# mock | razorpay
# On Vercel: set these on the SERVER project (kushlov-server), then redeploy.
PAYMENT_PROVIDER=razorpay
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Razorpay (Dashboard → API Keys). Never expose KEY_SECRET to the frontend.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
# Optional — set if you configure webhooks in Razorpay Dashboard
RAZORPAY_WEBHOOK_SECRET=

# On Vercel WEB project (kushlov-web) you MUST set (then Redeploy):
# NEXT_PUBLIC_API_URL=https://kushlov-server.vercel.app
# NEXT_PUBLIC_SOCKET_URL=https://kushlov-server.vercel.app
# NEXT_PUBLIC_SITE_URL=https://kushlov-web.vercel.app
# On Vercel SERVER project also set:
# CLIENT_URL=https://kushlov-web.vercel.app
# CORS_ORIGINS=https://kushlov-web.vercel.app

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Location / local exclusion zone (OpenStreetMap coordinates, km) ---
# Users WITHIN this radius cannot see or connect; only users farther away can.
DISCOVERY_RADIUS_KM=20

# --- Bootstrap admin (seeded on first run if set) ---
ADMIN_EMAIL=admin@kushlov.app
ADMIN_PASSWORD=Admin@12345

# --- Firebase (Google sign-in) ---
# Frontend — from Firebase Console → Project settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Backend — from Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

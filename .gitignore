# dependencies
node_modules/
.pnpm-store/

# builds
dist/
dist-vercel/
build/
.next/
out/

# env
.env
.env.local
.env.*.local

# Apple Push / signing secrets — never commit
*.p8
*.p12
AuthKey_*.p8

# Firebase / FCM native config — per-environment, supplied via EAS file secrets
google-services.json
GoogleService-Info.plist

# Service account private keys — belong in EAS credentials or server env, never here
*-firebase-adminsdk-*.json
*service-account*.json
*serviceAccount*.json

# logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# testing / coverage
coverage/

# Android APK — ~100MB+, over GitHub's file limit. Serve from
# apps/web/public/kushlov.apk on the web host so /kushlov.apk downloads.
*.apk

# uploads (local temp)
apps/server/uploads/
tmp/
apps/server/.env.save

# Prefer nodeLinker in pnpm-workspace.yaml (pnpm 10+/11). Keep this for
# older tooling that still reads .npmrc during EAS installs.
node-linker=hoisted
# Avoid interactive prompts in CI / EAS builds
confirmModulesPurge=false
# Ensure Babel presets/plugins and Expo packages are visible to Metro/Babel
public-hoist-pattern[]=*babel*
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*metro*

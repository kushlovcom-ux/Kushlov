EXPO_PUBLIC_API_URL=https://kushlov-server.vercel.app/api
EXPO_PUBLIC_SOCKET_URL=https://kushlov-server.vercel.app
EXPO_PUBLIC_SITE_URL=https://www.klproind.com
# Deep links also accept https://genzone.cloud / https://www.genzone.cloud (see app.config + linking)
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Web client ID is required (used to receive the ID token / Firebase audience).
# Android client ID is required for Google Sign-In on Android (package + SHA-1).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_EAS_PROJECT_ID=ecab9e35-1360-4ce3-b5fb-25076affb3a2
